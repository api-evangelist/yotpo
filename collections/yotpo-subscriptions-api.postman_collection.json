  "info": {
    "_postman_id": "11cb5ce7-6de0-453b-9931-9183b180c66d",
    "name": "Yotpo Authentication Subscriptions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Specification of Yotpo's e-commerce retention APIs covering reviews and user-generated content, loyalty and referrals, SMS, subscriptions (Core API), and email. Reviews/UGC, SMS, Email, and Core API requests are authenticated with an app key and an OAuth utoken obtained from the store secret; the Loyalty & Referrals API is authenticated with x-guid and x-api-key headers.\n\nContact Support:\n Name: Yotpo Support",
      "type": "text/plain"
    }
  }
